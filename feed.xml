---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Luca van Ruiten — Blog</title>
    <link>{{ '/blog/' | absolute_url }}</link>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    <description>Stories behind the photographs by Luca van Ruiten, a queer photographer in Rotterdam.</description>
    <language>en</language>
    {%- if site.posts.size > 0 %}
    <lastBuildDate>{{ site.posts.first.date | date_to_rfc822 }}</lastBuildDate>
    {%- endif %}
    {%- for post in site.posts limit:20 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <description>{{ post.intro | xml_escape }}</description>
      {%- if post.cover %}
      <enclosure url="{{ post.cover | absolute_url }}" type="image/{% if post.cover contains '.webp' %}webp{% else %}jpeg{% endif %}" length="0"/>
      {%- endif %}
    </item>
    {%- endfor %}
  </channel>
</rss>
